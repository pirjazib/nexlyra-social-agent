# Set in Netlify project > Environment variables (not committed to Git).
DASHBOARD_PASSWORD=replace_with_a_long_unique_password
SESSION_SECRET=replace_with_a_different_long_random_secret
CRON_SECRET=replace_with_another_long_random_secret
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Publishing requires platform authorizations for your PERSONAL accounts
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=urn:li:person:YOUR_ID
LINKEDIN_VERSION=202610
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
# Default safe workflow: approval required. Can change in dashboard.
# Optional: set if using API-based news provider later
